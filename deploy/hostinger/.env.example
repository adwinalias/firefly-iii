# Copy to .env on the VPS only; chmod 600. Never commit the populated file.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://finance.adwinalias.com
SITE_OWNER=replace-with-owner-email
APP_KEY=replace-with-random-32-character-string
TZ=Asia/Dubai
TRUSTED_PROXIES=**
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
LOG_CHANNEL=stack
APP_LOG_LEVEL=warning
AUDIT_LOG_LEVEL=emergency
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=replace-with-long-random-password
STATIC_CRON_TOKEN=replace-with-random-32-char-token
MAIL_MAILER=log
